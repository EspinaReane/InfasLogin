@model InfasLogin.Models.User

@{
    Layout = "_Login";
    ViewData["Title"] = "Login";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>

    body, html {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #004D4D 0%, #003B3B 100%);
        height: 100%;
        overflow: hidden;
    }

    .login-container {
        display: flex;
        height: 100vh;
    }

    .left-panel {
        flex: 1;
        background: url('/loginImage.png') center center no-repeat;
        background-size: cover;
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 60px;
        background-color: #003B3B;
        clip-path: polygon(0 0, 100% 0, 80% 100%, 0% 100%);
    }

        .left-panel h1 {
            font-weight: 600;
        }

        .left-panel p {
            font-size: 1rem;
            color: #f0eaea;
        }

    .right-panel {
        flex: 1;        display: flex;
        justify-content: center;
        align-items: center;
        color: white;
        flex-direction: column;
        padding: 60px;
        clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
        box-shadow: -10px 0 20px rgba(0, 0, 0, 0.1);
    }

    .form-box {
        background-color: #f1f1f1;
        padding: 40px;
        border-radius: 10px;
        width: 100%;
        max-width: 400px;
        color: #333;
    }

        .form-box h3 {
            font-weight: bold;
            margin-bottom: 10px;
        }

    .form-check-label {
        margin-left: 5px;
    }

    .btn-primary {
        background: linear-gradient(to right, #00b4db, #0083b0);
        border: none;
    }

        .btn-primary:hover {
            opacity: 0.9;
        }

    a {
        color: #0083b0;
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }
</style>

<div class="login-container">
    <!-- Left Side: Image and Text -->
    <div class="left-panel">
        <h1>Your Recovery Journey Starts Here!</h1>
        <p>Bringing quality healthcare delivery to everyone</p>
    </div>

    <!-- Right Side: Login Form -->
    <div class="right-panel">
        <div class="text-center mb-4">
            <h2 style="font-weight: bold;">LOGO</h2>
        </div>

        <div class="form-box">
            <h3 class="text-center">Welcome Back</h3>
            <p class="mb-4 text-muted text-center">Please sign in to your account</p>

            <form asp-controller="Login" asp-action="Login" method="post" class="">
                <div class="col-md-12">
                    <label asp-for="Username" class="form-label">Email or username</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username"></span>
                </div>
             
                <div class="col-md-12   ">
                    <label asp-for="Password" class="form-label">Password</label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password"></span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <div>
                        <input type="checkbox" class="form-check-input" id="rememberMe" />
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#">Forgot Password</a>
                </div>

                <button type="submit" class="btn btn-primary w-100">Login</button>
            </form>

            <p class="text-center mt-3">Don't have an account? <a href="#">Sign Up</a></p>
        </div>
    </div>
</div>
